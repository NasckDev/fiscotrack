{
  "name": "@fiscotrack/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/ui/chart/echarts.ts",
    "./src/ui/theme/AppThemeProvider.tsx"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:portable": "vite build --base ./ --outDir dist-portable --emptyOutDir",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@fiscotrack/engine": "0.1.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "antd": "6.7.1",
    "dayjs": "1.11.23",
    "echarts": "6.1.0",
    "echarts-for-react": "3.1.0",
    "idb": "8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/react-vite": "10.6.8",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.1",
    "rollup-plugin-visualizer": "7.1.3",
    "storybook": "10.6.8",
    "vite": "8.3.8"
  }
}
